# Copy to .env and fill in real values. NEVER commit .env.
# Values are intentionally left empty so secret scanners have nothing to match.

# --- required -----------------------------------------------------------------
# Your OpenRouter API key (format: sk-or-v1-...)
OPENROUTER_API_KEY=

# Bearer token clients present to the proxy; also the Admin UI login password.
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# Encrypts provider credentials stored in the DB (models added via the UI).
# Generate with: openssl rand -hex 32
# Set BEFORE adding any model in the UI and NEVER rotate afterward — rotating
# makes credentials already stored in the DB undecryptable.
LITELLM_SALT_KEY=

POSTGRES_USER=litellm
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# --- injection classifier (defaults shown; override only if needed) ----------
# GUARD_MODEL_ID=leolee99/PIGuard
# GUARD_MODEL_REVISION=dd78b24e330193a22d2293ac66922dd4f982f563
# GUARD_TRUST_REMOTE_CODE=1
# GUARD_THRESHOLD=0.85

# Only needed for gated models (e.g. meta-llama/Llama-Prompt-Guard-2-86M):
# HF_TOKEN=
